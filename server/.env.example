# ==========================================
# ArcShield Server Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5000

# MongoDB Atlas Persistent Database URI
MONGODB_URI=
MONGODB_DB_NAME=arcshield

# Redis Temporary State & Rate Limiting URI
REDIS_URL=

# JWT Secrets (High entropy random strings)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin(s)
CLIENT_URL=http://localhost:3000
SERVER_URL=http://localhost:5000

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
