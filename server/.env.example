# ==========================================
# ArcShield Server Environment Configuration
# ==========================================
NODE_ENV=development
PORT=5000

# MongoDB Atlas Persistent Database URI
MONGODB_URI=
MONGODB_DB_NAME=arcshield

# Redis Temporary State & Rate Limiting (Local Redis for Dev, Upstash Cloud Redis for Production Render)
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# JWT Secrets (High entropy random strings)
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin(s) (In production: https://arc-sheild.vercel.app)
CLIENT_URL=https://arc-sheild.vercel.app
SERVER_URL=https://arcsheild.onrender.com

# Rate Limits
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
