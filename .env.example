# ==========================================
# ArcShield Centralized Environment Template (.env)
# ==========================================
# Copy this file to .env in the project root for local development.
# ArcShield uses a centralized root .env for local development.
# Production environment variables are configured separately in Render and Vercel.
# NEVER commit real credentials or secrets to version control.

# Backend Configuration
NODE_ENV=development
PORT=5000
MONGODB_URI=
MONGODB_DB_NAME=arcshield
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
JWT_SECRET=
JWT_REFRESH_SECRET=
CLIENT_URL=http://localhost:5173
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# Frontend Configuration (Safe for browser exposure via VITE_ prefix)
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
