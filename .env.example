# ==========================================
# ArcShield Platform Environment Template
# ==========================================
# Copy this file to .env or configure these variables in your deployment dashboard (Render / Vercel).
# NEVER commit real credentials or secrets to version control.

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Atlas Connection URI (TLS/SSL ReplicaSet)
# Example: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/arcshield?retryWrites=true&w=majority
MONGODB_URI=

# Optional MongoDB Database Name
MONGODB_DB_NAME=arcshield

# Redis Cache & Throttling URI (TLS enabled in production: rediss://...)
# Example: redis://default:<password>@<redis-host>:6379
REDIS_URL=

# JWT Secrets for Access and Refresh Tokens
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token Expiration Settings
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# Backend Base URL (Used for webhook/service callbacks)
SERVER_URL=http://localhost:5000

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
